# Groq (LLM principal e guardrail)
GROQ_API_KEY=
GROQ_AI_MODEL=qwen/qwen3-32b
GROQ_AI_GUARDRAILS_MODEL=
# Orquestrador (tool-calling) — use um modelo não-reasoning, ex.: llama-3.3-70b-versatile
GROQ_AI_TOOLS_MODEL=llama-3.3-70b-versatile

# WAHA (WhatsApp HTTP API)
WAHA_URL=http://waha:3000
WAHA_API_KEY=
WAHA_SESSION=default
WAHA_DASHBOARD_USERNAME=
WAHA_DASHBOARD_PASSWORD=
WHATSAPP_SWAGGER_USERNAME=
WHATSAPP_SWAGGER_PASSWORD=

# Chroma (vector store)
CHROMA_API_KEY=
CHROMA_TENANT_ID=
CHROMA_DATABASE=
CHROMA_COLLECTION_NAME=tcc-grobid-data

# Cohere (reranker)
COHERE_API_KEY=

# HuggingFace (opcional — embeddings rodam local com all-MiniLM-L6-v2)
HUGGINGFACE_API_KEY=

# CORS — JSON array de origens permitidas
ALLOW_ORIGINS=["http://localhost:3000"]


