SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Garantir que o container use a credencial montada (variáveis no formato VAR=value)
GOOGLE_APPLICATION_CREDENTIALS=/app/firebase-credentials.json
# Certifique-se de usar o python instalado no container (caminho absoluto)
# Use the python from /usr/local/bin (we'll symlink it to the venv python in the Dockerfile)
PYTHON=/usr/local/bin/python
# Opcional: sobrescrever a URL do WAHA se necessario (usado por config.Settings)
WAHA_URL=http://waha:3000

# Run every 5 minutes (min hour dom mon dow user command)
# */5 * * * * root cd /app && $PYTHON /app/services/scheduler/send_daily_reminders.py >> /var/log/send_daily_reminders.log 2>&1

# Optional debug: uncomment to write a timestamp every minute to the same log (helps validate cron)
# * * * * * root echo "cron-ok $(date)" >> /var/log/send_daily_reminders.log 2>&1

# Run every 5 minutes (min hour dom mon dow user command)
* * * * * root cd /app && $PYTHON /app/services/scheduler/send_daily_reminders.py >> /var/log/send_daily_reminders.log 2>&1

# end line

