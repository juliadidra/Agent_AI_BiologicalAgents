FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /app

# Install cron and python3 (with pip) and cleanup apt lists
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        cron python3 python3-venv python3-pip ca-certificates \
        build-essential gcc libssl-dev libffi-dev python3-dev cargo \
    && rm -rf /var/lib/apt/lists/*

# Ensure a /usr/local/bin/python points to the venv python (so cron uses the virtualenv Python)
RUN ln -sf /opt/venv/bin/python /usr/local/bin/python

# Create a virtual environment and use it for installing Python packages to avoid PEP 668 errors
RUN /usr/bin/python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip setuptools wheel


# Install Python dependencies (if any)
COPY requirements.txt requirements.txt
RUN /opt/venv/bin/pip install --upgrade pip setuptools wheel \
    && /opt/venv/bin/pip install --no-cache-dir -r requirements.txt

COPY . .

# Ensure the virtualenv is first on PATH at runtime
ENV PATH="/opt/venv/bin:$PATH"

# Copy cron file into /etc/cron.d and set permissions. System cron reads /etc/cron.d automatically.
COPY services/scheduler/send_daily_cron /etc/cron.d/send_daily_cron
RUN chmod 0644 /etc/cron.d/send_daily_cron \
    && mkdir -p /var/log \
    && touch /var/log/send_daily_reminders.log

# Run cron in foreground so Docker container stays alive and logs are available
ENTRYPOINT ["/usr/sbin/cron", "-f"]